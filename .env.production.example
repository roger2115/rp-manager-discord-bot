# Production Environment Variables Template
# Copy this file and fill in your production values

# ============================================
# BACKEND (.env in packages/backend/)
# ============================================

# Server Configuration
PORT=3003
NODE_ENV=production

# Database (PostgreSQL for production)
DATABASE_URL="postgresql://username:password@host:5432/database_name"

# Discord OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=https://your-backend-domain.com/api/auth/callback
DISCORD_BOT_TOKEN=your_discord_bot_token

# Security
SESSION_SECRET=generate_random_32plus_character_string
ENCRYPTION_KEY=exactly_32_character_string_here

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Redis (Optional - for caching and session storage)
REDIS_URL=redis://username:password@host:6379

# ============================================
# BOT (.env in packages/bot/)
# ============================================

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token

# Backend API
API_URL=https://your-backend-domain.com

# Environment
NODE_ENV=production

# ============================================
# FRONTEND (.env.local in packages/frontend/)
# ============================================

# Backend API URL
NEXT_PUBLIC_API_URL=https://your-backend-domain.com

# ============================================
# GENERATION COMMANDS
# ============================================

# Generate SESSION_SECRET (32+ characters):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Generate ENCRYPTION_KEY (exactly 32 characters):
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================

# [ ] Replace all placeholder values above
# [ ] Verify ENCRYPTION_KEY is exactly 32 characters
# [ ] Update Discord OAuth callback URL in Discord Developer Portal
# [ ] Enable MESSAGE CONTENT INTENT in Discord Bot settings
# [ ] Run database migrations: npx prisma migrate deploy
# [ ] Seed database: npx prisma db seed
# [ ] Test authentication flow
# [ ] Test bot message proxying
# [ ] Set up SSL/HTTPS
# [ ] Configure monitoring and logging
# [ ] Set up automated database backups
